{
  "name": "traceability-agent",
  "version": "0.1.0",
  "description": "MCP server for cross-repository integration mapping, contract-breakage detection and impact analysis, with the graph materialized as an Obsidian vault.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fecuencas/traceability-agent.git"
  },
  "bugs": {
    "url": "https://github.com/fecuencas/traceability-agent/issues"
  },
  "homepage": "https://github.com/fecuencas/traceability-agent",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "traceability-agent-mcp": "dist/server.js",
    "traceability-agent": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "test": "npm run build && find dist -name '*.test.js' -print0 | xargs -0 node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.11.1",
    "mermaid": "^12.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.6.0"
  }
}
